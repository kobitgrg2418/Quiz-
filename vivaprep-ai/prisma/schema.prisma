generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  preferences   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  documents     Document[]
  quizAttempts  QuizAttempt[]
  flashcardSets FlashcardSet[]
  studySessions StudySession[]
  chatMessages  ChatMessage[]
  notes         Note[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id        String         @id @default(cuid())
  title     String
  fileName  String
  fileUrl   String
  fileSize  Int
  pageCount Int            @default(0)
  mimeType  String         @default("application/pdf")
  status    DocumentStatus @default(PROCESSING)
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]
  quizzes       Quiz[]
  flashcardSets FlashcardSet[]
  chatMessages  ChatMessage[]
  notes         Note[]
  topics        Topic[]

  @@index([userId])
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

model DocumentChunk {
  id         String  @id @default(cuid())
  documentId String
  content    String
  pageNumber Int
  chunkIndex Int
  embedding  String   @default("[]")
  metadata   Json?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Topic {
  id         String @id @default(cuid())
  name       String
  documentId String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Quiz {
  id         String   @id @default(cuid())
  title      String
  documentId String
  mode       QuizMode @default(MEDIUM)
  type       QuizType @default(MIXED)
  createdAt  DateTime @default(now())

  document  Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([documentId])
}

enum QuizMode {
  EASY
  MEDIUM
  HARD
  VIVA
  INTERVIEW
}

enum QuizType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  SCENARIO
  MIXED
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  type        QuestionType
  question    String
  options     Json?
  answer      String
  explanation String?
  points      Int          @default(1)
  order       Int          @default(0)

  quiz    Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@index([quizId])
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  SCENARIO
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  score       Float     @default(0)
  totalPoints Int       @default(0)
  timeTaken   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  quiz    Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@index([userId])
  @@index([quizId])
}

model QuizAttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  userAnswer String
  isCorrect  Boolean @default(false)

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model FlashcardSet {
  id         String   @id @default(cuid())
  title      String
  documentId String
  userId     String
  createdAt  DateTime @default(now())

  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@index([userId])
  @@index([documentId])
}

model Flashcard {
  id         String              @id @default(cuid())
  setId      String
  front      String
  back       String
  example    String?
  note       String?
  difficulty FlashcardDifficulty @default(NORMAL)
  order      Int                 @default(0)
  nextReview DateTime?
  interval   Int                 @default(1)

  set FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
}

enum FlashcardDifficulty {
  EASY
  NORMAL
  HARD
}

model Note {
  id         String   @id @default(cuid())
  title      String
  content    String
  mode       NoteMode @default(CONCISE)
  documentId String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
}

enum NoteMode {
  CONCISE
  DETAILED
  EXAM
  PRESENTATION
}

model ChatMessage {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  role       String
  content    String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId, userId])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  type      String
  duration  Int      @default(0)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
